{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    { "source": "/api/inquiries/:path*", "destination": "/api/inquiries" },
    { "source": "/api/inquiries", "destination": "/api/inquiries" },
    { "source": "/api/auth/:path*", "destination": "/api/auth" },
    { "source": "/api/auth", "destination": "/api/auth" },
    { "source": "/api/success-stories/:path*", "destination": "/api/success-stories" },
    { "source": "/api/success-stories", "destination": "/api/success-stories" },
    { "source": "/api/blogs/:path*", "destination": "/api/blogs" },
    { "source": "/api/blogs", "destination": "/api/blogs" },
    { "source": "/api/upload/:path*", "destination": "/api/upload" },
    { "source": "/api/upload", "destination": "/api/upload" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
